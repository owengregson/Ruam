{
	"name": "ruam",
	"version": "2.0.0",
	"description": "Full-language JavaScript compatibility with guarded Isogloss BPRF protection and explicit deployment profiles",
	"keywords": [
		"obfuscator",
		"obfuscation",
		"javascript-obfuscator",
		"source-protection",
		"isogloss",
		"dynamic-analysis",
		"analysis-cost",
		"code-protection",
		"security"
	],
	"homepage": "https://github.com/owengregson/Ruam#readme",
	"bugs": {
		"url": "https://github.com/owengregson/Ruam/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/owengregson/Ruam.git",
		"directory": "packages/ruam"
	},
	"author": "Owen Gregson <owen@owen.lol> (https://github.com/owengregson)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"bin": {
		"ruam": "dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "bun run typecheck && bun test && bun run build",
		"build:browser": "node scripts/build-browser.mjs",
		"bench": "bun scripts/bench.mjs",
		"bench:architectures": "bun scripts/bench-architectures.mjs",
		"typecheck": "tsc --noEmit",
		"dev": "tsup --watch",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "LGPL-2.1-only",
	"dependencies": {
		"@babel/generator": "^7.25.0",
		"@babel/parser": "^7.25.0",
		"@babel/traverse": "^7.25.0",
		"@babel/types": "^7.25.0",
		"@inquirer/prompts": "^8.3.0",
		"chalk": "^5.6.2",
		"fs-extra": "^11.2.0",
		"globby": "^14.0.2",
		"ora": "^9.3.0"
	},
	"devDependencies": {
		"@types/babel__generator": "^7.6.8",
		"@types/babel__traverse": "^7.20.6",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.14.0",
		"esbuild": "^0.28.1",
		"tsup": "^8.4.0",
		"typescript": "^5.7.0"
	}
}
